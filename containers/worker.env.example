# Compose environment example for the container profiles.
#
#   cp containers/worker.env.example .env      # `.env` is git-ignored
#
# Only non-secret knobs live here. Credentials never belong in this file:
# the PostgreSQL password is a Docker secret read from
# $HOME/.local/state/code-factory/secrets/postgres_password (owner-only mode).
#
# Values mirror containers/factory.container.yml. If you change FACTORY_USER,
# FACTORY_HOME or FACTORY_WORKSPACE you must change that document too, or the
# worker build fails its configuration-consistency guard.

# --- worker identity (must match containers/factory.container.yml) -----------
FACTORY_USER=coder
FACTORY_UID=1000
FACTORY_GID=1000
FACTORY_HOME=/home/coder
FACTORY_WORKSPACE=/home/coder/Dev

# --- worker image and resource caps ------------------------------------------
CODE_FACTORY_TAG=dev
WORKER_CPUS=4
WORKER_MEMORY=6g
WORKER_MEMORY_RESERVATION=1g
WORKER_PIDS=4096
WORKER_SHM=512m

# --- optional example backing services (compose profile "data") --------------
# Ports are published on loopback only.
POSTGRES_USER=developer
POSTGRES_DB=developer
POSTGRES_PORT=15432
POSTGRES_CPUS=1
POSTGRES_MEMORY=1g
POSTGRES_PIDS=512

REDIS_PORT=16379
REDIS_MAXMEMORY=256mb
REDIS_CPUS=1
REDIS_MEMORY=512m
REDIS_PIDS=256
