{{ ansible_managed | comment }}
# noVNC bridge, bound to 127.0.0.1 only.
# This is an unauthenticated HTTP listener by design, so it must never be
# published: reach it with `ssh -N -L {{ factory_cfg.desktop.novnc_port }}:127.0.0.1:{{ factory_cfg.desktop.novnc_port }} <host>`.

[Unit]
Description=Code Factory noVNC bridge (127.0.0.1:{{ factory_cfg.desktop.novnc_port }}, loopback only)
Documentation=https://github.com/novnc/websockify
Requires=code-factory-vnc.service
After=code-factory-vnc.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/websockify --web={{ factory_novnc_web_root }} 127.0.0.1:{{ factory_cfg.desktop.novnc_port }} 127.0.0.1:{{ factory_vnc_rfb_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
