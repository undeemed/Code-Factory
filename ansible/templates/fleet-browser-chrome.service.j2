{{ ansible_managed | comment }}
# Tier 2: headless Chromium with a persistent profile, on demand
# (`fleet-browser up chrome`), stopped by fleet-browser gc after 30 idle min.

[Unit]
Description=Fleet browser tier 2 - headless Chromium on 127.0.0.1:9522 (Code Factory managed)
ConditionPathExists={{ factory_fleet_browsers_dir }}/fleet-browser

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{ factory_fleet_browsers_dir }}/fleet-browser _run-chrome
Restart=on-failure
RestartSec=5
MemoryMax=4G
